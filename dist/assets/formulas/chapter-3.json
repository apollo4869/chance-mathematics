    "display": false
  },
  {
    "section": "chapter-3",
    "ordinal": 148,
    "tex": "\\begin{aligned}\r\n\\phi_{Z_n}(t)\r\n&=\r\n\\prod_{i=1}^n\r\n\\phi_{Y_i}\\left(\\frac{t}{\\sqrt n}\\right)\\\\\r\n&=\r\n\\left[\r\n\\phi_Y\\left(\\frac{t}{\\sqrt n}\\right)\r\n\\right]^n.\r\n\\end{aligned}",
    "display": true
  },
