    "ordinal": 134,
    "tex": "X,Y",
    "display": false
  },
  {
    "section": "chapter-3",
    "ordinal": 135,
    "tex": "\\begin{aligned}\r\n\\phi_{X+Y}(t)\r\n&=\\mathbb E[e^{it(X+Y)}]\\\\\r\n&=\\mathbb E[e^{itX}e^{itY}]\\\\\r\n&=\\mathbb E[e^{itX}]\\mathbb E[e^{itY}]\\\\\r\n&=\\phi_X(t)\\phi_Y(t).\r\n\\end{aligned}",
    "display": true
  },
  {
    "section": "chapter-3",
    "ordinal": 136,
    "tex": "\\boxed{\r\n\\phi_{X+Y}(t)=\\phi_X(t)\\phi_Y(t).\r\n}",
    "display": true
