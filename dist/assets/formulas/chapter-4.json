    "tex": "\\begin{aligned}\r\n&p(x,t+\\Delta t)-p(x,t)\\\\\r\n&=\\frac12\\left[\r\np(x-\\Delta x,t)-2p(x,t)+p(x+\\Delta x,t)\r\n\\right].\r\n\\end{aligned}",
