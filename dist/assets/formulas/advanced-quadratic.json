[
  {
    "section": "advanced-quadratic",
    "ordinal": 1,
    "tex": "t\\longmapsto B_t(\\omega).",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 2,
    "tex": "v(t)=\\lim_{h\\to0}\\frac{B_{t+h}-B_t}{h}.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 3,
    "tex": "B_{t+h}-B_t\\sim N(0,h)",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 4,
    "tex": "h>0",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 5,
    "tex": "\\frac{B_{t+h}-B_t}{h}\r\n\\sim N\\left(0,\\frac1h\\right).",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 6,
    "tex": "h\\downarrow0",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 7,
    "tex": "M>0",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 8,
    "tex": "P\\left(\r\n\\left|\\frac{B_{t+h}-B_t}{h}\\right|\\le M\r\n\\right)\\longrightarrow0.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 9,
    "tex": "\\boxed{\r\n\\text{样本路径连续}\r\n\\quad\\text{但几乎必然处处不可导}.\r\n}",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 10,
    "tex": "[0,T]",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 11,
    "tex": "t_k=\\frac{kT}{2^m},\r\n\\qquad k=0,\\ldots,2^m.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 12,
    "tex": "Q_m=\r\n\\sum_{k=0}^{2^m-1}\r\n(B_{t_{k+1}}-B_{t_k})^2.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 13,
    "tex": "B_{t_{k+1}}-B_{t_k}\r\n\\sim N\\left(0,\\frac{T}{2^m}\\right),",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 14,
    "tex": "\\mathbb E[Q_m]\r\n=\r\n2^m\\cdot\\frac{T}{2^m}\r\n=T.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 15,
    "tex": "v",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 16,
    "tex": "Z",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 17,
    "tex": "\\operatorname{Var}(Z^2)=2v^2.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 18,
    "tex": "\\begin{aligned}\r\n\\operatorname{Var}(Q_m)\r\n&=\r\n2^m\\cdot2\\left(\\frac{T}{2^m}\\right)^2\\\\\r\n&=\\frac{2T^2}{2^m}.\r\n\\end{aligned}",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 19,
    "tex": "Q_m\\longrightarrow T",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 20,
    "tex": "L^2",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 21,
    "tex": "P(|Q_m-T|>\\varepsilon)\r\n\\le\r\n\\frac{2T^2}{\\varepsilon^2 2^m}.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 22,
    "tex": "m",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 23,
    "tex": "\\boxed{\r\nQ_m\\xrightarrow{\\mathrm{a.s.}}T.\r\n}",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 24,
    "tex": "\\boxed{[B]_T=T.}",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 25,
    "tex": "f:[0,T]\\to\\mathbb R",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 26,
    "tex": "|f(t_{k+1})-f(t_k)|\r\n\\le M(t_{k+1}-t_k)",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 27,
    "tex": "M=\\sup_{0\\le t\\le T}|f'(t)|<\\infty.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 28,
    "tex": "\\begin{aligned}\r\n\\sum_k(f(t_{k+1})-f(t_k))^2\r\n&\\le\r\nM^2\\sum_k(t_{k+1}-t_k)^2\\\\\r\n&=M^2\\frac{T^2}{2^m}\\\\\r\n&\\longrightarrow0.\r\n\\end{aligned}",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 29,
    "tex": "\\sum_k(B_{t_{k+1}}-B_{t_k})^2\r\n\\longrightarrow T.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 30,
    "tex": "\\boxed{\r\n\\begin{aligned}\r\n\\text{光滑路径：}&\\quad [f]_T=0,\\\\\r\n\\text{Brownian 路径：}&\\quad [B]_T=T.\r\n\\end{aligned}\r\n}",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 31,
    "tex": "dx=O(dt),",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 32,
    "tex": "(dx)^2=O(dt^2),",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 33,
    "tex": "dt",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 34,
    "tex": "dB\\sim O(\\sqrt{dt})",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 35,
    "tex": "(dB)^2\\sim O(dt).",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 36,
    "tex": "\\boxed{(dB_t)^2=dt}",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 37,
    "tex": "dB_t",
    "display": false
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 38,
    "tex": "d(B_t^2)=2B_t\\,dB_t.",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 39,
    "tex": "\\boxed{\r\nd(B_t^2)=2B_t\\,dB_t+dt.\r\n}",
    "display": true
  },
  {
    "section": "advanced-quadratic",
    "ordinal": 40,
    "tex": "dt",
    "display": false
  }
]