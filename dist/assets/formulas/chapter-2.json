    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 121,
    "tex": "\\int_0^1u^7(1-u)^3\\,du\r\n=\r\nB(8,4)\r\n=\r\n\\frac{7!\\,3!}{11!}.",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 122,
