    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 172,
    "tex": "U=\\Theta^2.",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 173,
    "tex": "\\Theta\\sim\\operatorname{Uniform}(0,1)",
    "display": false
