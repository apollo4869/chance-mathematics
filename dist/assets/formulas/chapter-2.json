    "section": "chapter-2",
    "ordinal": 137,
    "tex": "\\boxed{\r\n\\begin{aligned}\r\n\\text{经验频率：}&\\quad \\frac{k}{n},\\\\[3pt]\r\n\\text{后验预测：}&\\quad \\frac{k+1}{n+2}.\r\n\\end{aligned}\r\n}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 138,
    "tex": "\\frac{k+1}{n+2}-\\frac{k}{n}\r\n=\r\n\\frac{n-2k}{n(n+2)}.",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 139,
    "tex": "\\left|\r\n\\frac{k+1}{n+2}-\\frac{k}{n}\r\n\\right|\r\n\\le\\frac1{n+2}.",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 140,
    "tex": "n\\to\\infty",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 141,
    "tex": "\\Theta\\sim\\operatorname{Uniform}(0,1),",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 142,
    "tex": "X_i\\mid\\Theta\r\n\\overset{\\mathrm{i.i.d.}}{\\sim}\r\n\\operatorname{Bernoulli}(\\Theta).",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 143,
    "tex": "\\Theta",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 144,
    "tex": "\\Theta",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 145,
    "tex": "P(X_1=1).",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 146,
    "tex": "\\begin{aligned}\r\nP(X_1=1)\r\n&=\\int_0^1P(X_1=1\\mid\\Theta=\\theta)\\,d\\theta\\\\\r\n&=\\int_0^1\\theta\\,d\\theta\\\\\r\n&=\\frac12.\r\n\\end{aligned}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 147,
    "tex": "1/2",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 148,
    "tex": "\\begin{aligned}\r\nP(X_1=1,X_2=1)\r\n&=\\int_0^1\r\nP(X_1=1,X_2=1\\mid\\Theta=\\theta)\\,d\\theta\\\\\r\n&=\\int_0^1\\theta^2\\,d\\theta\\\\\r\n&=\\frac13.\r\n\\end{aligned}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 149,
    "tex": "P(X_1=1)P(X_2=1)=\\frac14.",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 150,
    "tex": "\\boxed{\r\nP(X_1=1,X_2=1)=\\frac13\\ne\\frac14.\r\n}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 151,
    "tex": "\\begin{aligned}\r\nP(X_2=1\\mid X_1=1)\r\n&=\\frac{P(X_1=1,X_2=1)}{P(X_1=1)}\\\\\r\n&=\\frac{1/3}{1/2}\\\\\r\n&=\\frac23.\r\n\\end{aligned}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 152,
    "tex": "1/2",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 153,
    "tex": "2/3",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 154,
    "tex": "\\Theta",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 155,
    "tex": "\\Theta",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 156,
    "tex": "\\mathbb E[X_i\\mid\\Theta]=\\Theta,",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 157,
    "tex": "\\Theta",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 158,
    "tex": "X_i,X_j",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 159,
    "tex": "i\\ne j",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 160,
    "tex": "\\begin{aligned}\r\n\\operatorname{Cov}(X_i,X_j)\r\n&=\\mathbb E[X_iX_j]-\\mathbb E[X_i]\\mathbb E[X_j]\\\\\r\n&=\\mathbb E[\\Theta^2]-(\\mathbb E[\\Theta])^2\\\\\r\n&=\\operatorname{Var}(\\Theta).\r\n\\end{aligned}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 161,
    "tex": "\\boxed{\r\n\\operatorname{Cov}(X_i,X_j)=\\frac1{12}>0.\r\n}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 162,
    "tex": "n",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 163,
    "tex": "x_1,\\ldots,x_n\\in\\{0,1\\}",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 164,
    "tex": "k=\\sum_{i=1}^n x_i.",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 165,
    "tex": "\\begin{aligned}\r\n&P(X_1=x_1,\\ldots,X_n=x_n)\\\\\r\n&\\qquad =\r\n\\int_0^1\\theta^k(1-\\theta)^{n-k}\\,d\\theta.\r\n\\end{aligned}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 166,
    "tex": "k",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 167,
    "tex": "\\sigma",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 168,
    "tex": "\\boxed{\r\n(X_1,\\ldots,X_n)\r\n\\overset d=\r\n(X_{\\sigma(1)},\\ldots,X_{\\sigma(n)}).\r\n}",
    "display": true
  },
  {
    "section": "chapter-2",
    "ordinal": 169,
    "tex": "\\Theta",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 170,
    "tex": "\\Theta\\sim\\operatorname{Uniform}(0,1)",
