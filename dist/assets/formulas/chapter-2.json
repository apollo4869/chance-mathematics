  {
    "section": "chapter-2",
    "ordinal": 48,
    "tex": "\\begin{aligned}\r\n\\operatorname{Var}_p(X_i)\r\n&=\\mathbb E_p[X_i^2]-(\\mathbb E_p[X_i])^2\\\\\r\n&=p-p^2\\\\\r\n&=p(1-p).\r\n\\end{aligned}",
    "display": true
