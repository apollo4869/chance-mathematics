    "tex": "0\\le u\\le1",
    "display": false
  },
  {
    "section": "chapter-2",
    "ordinal": 175,
    "tex": "\\begin{aligned}\r\nP(U\\le u)\r\n&=P(\\Theta^2\\le u)\\\\\r\n&=P(\\Theta\\le\\sqrt u)\\\\\r\n&=\\sqrt u.\r\n\\end{aligned}",
    "display": true
  },
  {
